# ======================================================================
#  Dukaan AI settings. Copy this file to ".env" and fill in your keys.
#  NEVER upload your .env file to GitHub (it is already in .gitignore).
# ======================================================================

# ---- App password: REQUIRED when the app runs on a server or you open it from your phone.
# Without it, the app only opens on this computer (http://localhost:8000).
APP_PASSWORD=

# ---- AI (free). Add at least ONE key. More keys = backup when a free limit is reached.
# Gemini (recommended, free):  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free, very fast):      https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (free models):    https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Which to try first
AI_PROVIDER_ORDER=gemini,groq,openrouter
# Optional: change models if a provider renames them (check their websites)
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Online store. Choose: wix | shopify | woocommerce | manual | auto
# auto = uses whichever store keys below are filled in; if none, manual mode
# manual = works with ANY platform (Etsy, Daraz, Gumroad, Payhip, your own site...):
#          the AI writes ready-to-paste listings and sells on WhatsApp
STORE_PLATFORM=auto
# Name of your platform, used in manual mode (e.g. Etsy, Daraz, Gumroad)
STORE_PLATFORM_NAME=

# ---- Shopify (optional)
# Shopify admin > Settings > Apps and sales channels > Develop apps > Create an app
# Admin API scopes: read_products, write_products, read_orders > Install > copy Admin API access token
SHOPIFY_STORE=
SHOPIFY_TOKEN=
SHOPIFY_API_VERSION=2025-07

# ---- WooCommerce / WordPress (optional)
# WooCommerce > Settings > Advanced > REST API > Add key (Read/Write)
WOO_URL=
WOO_KEY=
WOO_SECRET=

# ---- Wix (optional)
# API key: https://manage.wix.com/account/api-keys  (give it Wix Stores, Media Manager, eCommerce permissions)
WIX_API_KEY=
# Site ID: open your site dashboard, it is the long id in the address: manage.wix.com/dashboard/<SITE_ID>/...
WIX_SITE_ID=

# ---- WhatsApp Cloud API (optional) — https://developers.facebook.com/apps
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=dukaan-verify
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Your own WhatsApp number (approvals and alerts come here). Format: 923001234567
OWNER_WHATSAPP=

# ---- Safety
# false = you reply APPROVE <n> before files are sent (recommended: screenshots can be faked)
# true  = files are sent automatically when every payment check passes
AUTO_DELIVER=false
PAYMENT_MAX_AGE_DAYS=3
